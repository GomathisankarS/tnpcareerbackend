NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tnp_job_portal
DB_USER=tnp_app
DB_PASSWORD=replace_locally
# Aiven: enable TLS and provide its downloaded CA certificate. Keep false for local MySQL.
DB_SSL=false
DB_SSL_CA_FILE=
# Local example: certs/ca.pem. Render Secret File example: /etc/secrets/ca.pem
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=50
DB_TIMEOUT_MS=5000
# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_locally_generated_random_secret
JWT_ISSUER=tnp-api
JWT_AUDIENCE=tnp-web
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800
AUTH_RATE_LIMIT=30
UPLOAD_DIR=private-uploads
# Separate EMPTY database ending in _test; never your development database.
TEST_DB_NAME=tnp_job_portal_test
# Set ADMIN_EMAIL, ADMIN_PASSWORD, ADMIN_NAME locally only for admin:create.
